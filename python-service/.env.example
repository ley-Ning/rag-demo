APP_NAME=RAG Python Service
APP_ENV=dev
APP_PORT=8090
CORS_ORIGINS=http://localhost:8081
MODEL_REGISTRY_FILE=data/models_registry.json
DOCUMENTS_UPLOAD_DIR=data/uploads

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=rag_demo
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass
POSTGRES_MIN_POOL_SIZE=2
POSTGRES_MAX_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=rag_demo

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=rag_pass
RABBITMQ_VHOST=/
RABBITMQ_DOCUMENTS_QUEUE=documents.upload

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

RAG_TOP_K=5
RAG_MIN_SCORE=0.5
RAG_PARENT_CHILD_RERANK=true
RAG_PARENT_CANDIDATE_MULTIPLIER=6
RAG_PARENT_CHILD_EXPAND_WINDOW=1
VECTOR_DIMENSION=1536
# 问答答案缓存：Redis 精确命中 + pgvector 语义命中；知识库变更自动失效
RAG_ANSWER_CACHE_ENABLED=true
RAG_ANSWER_CACHE_TTL_SEC=3600
RAG_SEMANTIC_CACHE_ENABLED=true
RAG_SEMANTIC_CACHE_THRESHOLD=0.92
RAG_ANSWER_CACHE_MAX_ENTRIES=5000

# 多轮对话记忆：注入最近 N 条历史（字符预算裁剪）；带历史时检索前先改写追问、跳过答案缓存
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_HISTORY_MAX_CHARS=8000
CHAT_QUESTION_REWRITE_ENABLED=true

MCP_ENABLED=true
MCP_AUTO_CALL=true
MCP_MAX_STEPS=6
MCP_HTTP_TIMEOUT_MS=12000
MCP_WEB_ALLOW_ALL_DOMAINS=true
MCP_WEB_MAX_CONTENT_CHARS=12000
MCP_WEB_REQUEST_TIMEOUT_SEC=12
DEEP_THINK_ENABLED=true
DEEP_THINK_MAX_ITERATIONS=3

# OpenSandbox 代码沙盒（docker-compose 里的 opensandbox-server，宿主端口 18092）
SANDBOX_ENABLED=true
OPEN_SANDBOX_DOMAIN=127.0.0.1:18092
OPEN_SANDBOX_API_KEY=rag-demo-dev-key
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TOTAL_TIMEOUT_SEC=120
SANDBOX_EXEC_TIMEOUT_SEC=30
SANDBOX_MAX_OUTPUT_CHARS=8000
SANDBOX_MAX_CODE_CHARS=20000

DOCUMENT_WORKER_ENABLED=true
DOCUMENT_WORKER_PREFETCH=2
DOCUMENT_WORKER_CHUNK_SIZE=400
DOCUMENT_WORKER_OVERLAP=50
DOCUMENT_WORKER_EMBEDDING_MODEL_ID=text-embedding-3-large
# 失败重试延迟档位（秒，逗号分隔升序）；业务性失败不重试直接进死信，重试耗尽进死信
DOCUMENT_WORKER_RETRY_DELAYS_SEC=5,30,120
